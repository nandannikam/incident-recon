# Copy to .env (never commit .env) and adjust. Every value is optional;
# the defaults shown here are what the app uses when a variable is absent.

# development | test | production. In production API_KEY becomes mandatory.
ENVIRONMENT=development

# Comma-separated, explicit origins only (no "*", no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limit in bytes (50 MB).
MAX_UPLOAD_BYTES=52428800

# Time window (minutes) used by graph edges and rules.
TIME_WINDOW_MINUTES=5

# Parsed-event count above which POST /analyze returns 202 and runs the
# graph + reasoning as a background job (poll GET /jobs/{id}).
BACKGROUND_ANALYSIS_THRESHOLD=5000

# Declared now, used by later steps: PostgreSQL (Step 7) and API auth (Step 8).
DATABASE_URL=sqlite:///./incidents.db
API_KEY=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Frontend (Vite) -- read by incident-dashboard, ignored by the backend.
VITE_API_BASE_URL=http://localhost:8000

# UPLOAD_DIR=
